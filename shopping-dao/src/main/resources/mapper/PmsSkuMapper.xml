<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shopping.dao.mapper.PmsSkuMapper">

    <!--
      逻辑删除 + 改写 sku_code，理由同 PmsAttributeMapper.softDelete（docs/04 §1.7 方案 C）。
      唯一索引 uk_sku_code (sku_code, deleted)：同一个编码被删两次会撞唯一键。

      长度安全：sku_code 是 varchar(64)，LEFT(sku_code, 36) + '_del_'(5) + 19 = 60 ≤ 64。
    -->
    <update id="softDelete">
        UPDATE `pms_sku`
        SET `deleted`  = 1,
            `sku_code` = CONCAT(LEFT(`sku_code`, 36), '_del_', `id`)
        WHERE `id` = #{id}
          AND `deleted` = 0
    </update>

</mapper>
